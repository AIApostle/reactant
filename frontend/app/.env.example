# Deployed frontend defaults. Use .env.local for local testing.
VITE_API_BASE_URL=https://reactant.onrender.com/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Public APIMatic Developer Portal URL. Do not put APIMatic API credentials in frontend variables.
VITE_APIMATIC_PORTAL_URL=
# Optional override; defaults to the API's public OpenAPI definition.
VITE_OPENAPI_SPEC_URL=https://reactant.onrender.com/api/v1/openapi.json

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PERISHABLE_KEY=replace-with-your-publishable-key
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_ANON_KEY are accepted aliases.

# Optional backend-only settings; do not copy real secrets into this template.
# SUPABASE_SECRET_KEY=
# Walrus Memory is configured on the backend, not through workspace integrations.
# MEMWAL_DELEGATE_KEY=
# MEMWAL_ACCOUNT_ID=
# MEMWAL_SERVER_URL=
# Required to encrypt website chat, Telegram, storefront, and payment credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Hosted frontend origin:
ALLOWED_WEB_ORIGINS=https://getreactant.vercel.app,http://localhost:5173
PUBLIC_API_BASE_URL=https://reactant.onrender.com
PUBLIC_FRONTEND_URL=https://getreactant.vercel.app
# AgentCard uses the connected business's PayPal credentials.
AGENTCARD_ENABLED=false
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RECEIVING_COUNTRIES=US
# Shopify app credentials from the Shopify Dev Dashboard.
# Register https://reactant.onrender.com/api/v1/integrations/callback/shopify
# as an allowed redirect URL.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_SCOPES=read_products,read_inventory,read_orders
# INVITATION_DELIVERY_URL=https://your-service.example/invitations
# INVITATION_DELIVERY_TOKEN=
# INTERNAL_SERVICE_TOKEN=
# Legacy deployment-level credentials; AgentCard never uses these.
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET_KEY=
# STRANDS_AGENT_ENABLED=false
# OPENROUTER_API_KEY=
# openrouter_api_key is also accepted by the settings loader.
# OPENROUTER_MODEL_ID=openrouter/free
# OPENROUTER_VISION_MODEL_ID=google/gemini-2.5-flash
# APP_ENV=development

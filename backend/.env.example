SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PERISHABLE_KEY=replace-with-your-publishable-key
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_ANON_KEY are accepted aliases.

# Optional backend-only settings; do not copy real secrets into this template.
# SUPABASE_SECRET_KEY=
# Walrus Memory is configured on the backend, not through workspace integrations.
# MEMWAL_DELEGATE_KEY=
# MEMWAL_ACCOUNT_ID=
# MEMWAL_SERVER_URL=
# Required to encrypt website chat, Telegram, storefront, and payment credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Hosted frontend origin:
ALLOWED_WEB_ORIGINS=https://reactant-theta.vercel.app,http://localhost:5173
PUBLIC_API_BASE_URL=https://reactant.onrender.com
# Render: https://reactant-theta.vercel.app
# Local checkout testing: http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
# Backend-only Reactant PayPal partner app credentials and BN attribution code.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
# PAYPAL_BN_CODE is also accepted for existing local environment files.
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_ONBOARDING_AFTER_PAYMENT_ENABLED=false
AGENTCARD_ENABLED=false
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Backend-only JSON map of PayPal integration IDs to their registered webhook IDs.
# PAYPAL_WEBHOOK_IDS={"<integration-id>":"<paypal-webhook-id>"}
PAYPAL_RECEIVING_COUNTRIES=US,NG
# Shopify app credentials from the Shopify Dev Dashboard.
# Register https://reactant.onrender.com/api/v1/integrations/callback/shopify
# as an allowed redirect URL.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_SCOPES=read_products,read_inventory,read_orders
# INVITATION_DELIVERY_URL=https://your-service.example/invitations
# INVITATION_DELIVERY_TOKEN=
# INTERNAL_SERVICE_TOKEN=
# Strands uses Google's Gemini API for model inference.
# STRANDS_AGENT_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-3.6-flash
# GEMINI_VISION_MODEL_ID=gemini-3.6-flash
# APP_ENV=development
